# Runtime configuration template. The release installer creates /opt/threat-detection-system/.env.
# Values marked "auto" are generated on first install and preserved during upgrades.

COMPOSE_PROJECT_NAME=threat-detection
RELEASE_VERSION=3.1.40
DEVICE_EXPECTED_HEARTBEAT_INTERVAL_SECONDS=1800
DEVICE_HEARTBEAT_DELAYED_AFTER_SECONDS=2100
DEVICE_HEARTBEAT_OFFLINE_AFTER_SECONDS=3900
DEVICE_DATA_ACTIVE_WINDOW_SECONDS=2100

# Single-node performance defaults. Increase only after measuring CPU, memory,
# database latency and Kafka consumer lag on the target host.
KAFKA_TOPIC_PARTITIONS=12
KAFKA_CONSUMER_CONCURRENCY=4
INGEST_EXECUTOR_CORE_SIZE=8
INGEST_EXECUTOR_MAX_SIZE=16
INGEST_EXECUTOR_QUEUE_CAPACITY=2000
FLINK_PARALLELISM=2
FLINK_TASK_SLOTS=4
FLINK_JDBC_SINK_PARALLELISM=2
FLINK_APT_SINK_PARALLELISM=1
USE_CHINA_MIRROR=true
BUILD_DATE=auto

# EMQX uses 8083 inside its container. Publish it on a host port that does not
# collide with the Threat Assessment HTTP API on host port 8083.
EMQX_WS_HOST_PORT=18084

POSTGRES_DB=threat_detection
POSTGRES_USER=threat_user
POSTGRES_PASSWORD=auto
JWT_SECRET=auto
TIRE_FERNET_KEY=auto
TIRE_SESSION_SECRET=auto
CONFIG_ENCRYPTION_KEY=auto
TIRE_INTERNAL_SERVICE_TOKEN=auto
ALERT_INTERNAL_SERVICE_TOKEN=auto
# Minimum assessment severity persisted to the alert center: INFO, LOW, MEDIUM, HIGH, or CRITICAL.
ALERT_INGESTION_MINIMUM_SEVERITY=LOW

# Optional mail notifications. Leave empty when email delivery is not configured.
SMTP_HOST=smtp.163.com
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS_ENABLED=false
INTEGRATION_TEST_EMAIL_RECIPIENT=

# Optional SMS notifications. Select twilio or aliyun and configure only the
# selected provider. Values are passed to alert-management by Compose.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Optional threat-intelligence providers.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VT_API_KEY=
# Legacy compatibility only; new installations should use VT_API_KEY.
VIRUSTOTAL_API_KEY=
GREYNOISE_API_KEY=
SHODAN_API_KEY=
THREATBOOK_API_KEY=
TIANJIYOUMENG_API_KEY=
FEED_POLLER_ENABLED=true

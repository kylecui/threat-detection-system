# Threat Detection System Docker Compose stack

[Unit]
Description=Threat Detection System (Docker Compose)
Documentation=file:/opt/threat-detection-system/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/threat-detection-system
ExecStart=/usr/bin/docker compose --env-file .env -f docker/docker-compose.yml up -d --remove-orphans
ExecStartPost=/opt/threat-detection-system/scripts/runtime-watchdog.sh --recover
ExecStop=/usr/bin/docker compose --env-file .env -f docker/docker-compose.yml stop
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
